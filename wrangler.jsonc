{
  "main": ".open-next/worker.js",
  "name": "turkishclub-website",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "ratelimits": [
    {
      "name": "APPLICATION_RATE_LIMITER",
      "namespace_id": "72001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]




}
